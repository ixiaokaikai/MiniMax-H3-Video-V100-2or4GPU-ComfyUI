# Unregistered VRetouchEr research is retained in the GitHub source tree for
# reproducibility, but it has no public node or bundled workflow.  Do not ship
# its pinned upstream source in the Registry runtime archive.  Besides reducing
# an unused ~research-only surface, this prevents the upstream SpyNet fallback
# downloader from appearing in an installable package; released nodes never
# import these modules.
h3_t8/skin_finish_vretoucher_adapter.py
h3_t8/skin_finish_vretoucher_runtime.py
h3_t8/skin_finish_vretoucher_pipeline.py
h3_t8/vendor/vretoucher_upstream/

